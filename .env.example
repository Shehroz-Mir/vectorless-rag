# Every setting the service reads (src/vectorless_rag/config.py, spec Section 10).
# Values below are the defaults. Copy only the lines you want to change into .env; never commit .env.

# Required
OPENAI_API_KEY=

# Models
# Builds the PageIndex tree and node summaries
INDEX_MODEL=gpt-5.6-luna
# Looks at figure pages at upload time and writes the invisible descriptions
VISION_MODEL=gpt-5.6-luna
# Answers questions; must read images and call tools through the Responses API
CHAT_MODEL=gpt-5.6-sol
# Parallel LLM calls per indexing job
INDEX_SUMMARY_CONCURRENCY=8

# Page images (enrichment and view_pages)
RENDER_DPI=170
# low | high | auto  (low gave wrong answers in the spikes)
VIEW_PAGES_IMAGE_DETAIL=high

# Figure-page detection
MIN_IMAGE_AREA_RATIO=0.03
MIN_GRAPHIC_CLUSTER_RATIO=0.01
MAX_CLUSTER_TEXT_DENSITY=5.0
MIN_VECTOR_FIGURE_AREA=0.02
MAX_FIGURE_PAGES=200
VISION_CONCURRENCY=4

# Scanned-document check: fail when more than SCANNED_PAGE_SHARE of pages have fewer chars
SCANNED_MAX_TEXT_CHARS=50
SCANNED_PAGE_SHARE=0.5

# Ingestion worker: documents enriched and indexed at the same time (one at a time per user for indexing)
INGESTION_WORKERS=2

# view_pages and agent limits
VIEW_PAGES_MAX_PAGES=3
VIEW_PAGES_MAX_CALLS=4
MAX_IMAGE_SETS_IN_CONTEXT=2
AGENT_MAX_STEPS=20
AGENT_TIMEOUT_S=120
# off | auto | detailed: reasoning summaries in the run's steps (/query "detail": "full"); no visible extra cost
AGENT_REASONING_SUMMARY=auto

# Storage and uploads (Data/ holds read-only sample PDFs; app files live under DATA_ROOT)
DATA_ROOT=var
DATABASE_URL=sqlite:///./var/app.db
MAX_UPLOAD_MB=50
MAX_PAGES=500

# Eval only (python -m evals.run), not read by the service. The judge model:
# EVAL_JUDGE_MODEL=gpt-5.6-sol
